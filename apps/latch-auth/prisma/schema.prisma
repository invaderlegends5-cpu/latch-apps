// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventType {
  LOGIN
  LOGOUT
  OTP_REQUEST
  OTP_FAILED
  REFRESH_SUCCESS
  REFRESH_FAILED
  TOKEN_REUSE
  SESSION_REVOKE
  SESSION_REVOKE_ALL
  SESSION_EXPIRED
  USED_REFRESH_TOKEN_PURGE
  SECURITY_CSRF_ERROR
  SECURITY_CSRF_MISMATCH
  AUTH_JWT_FAILURE
  TENANT_VALIDATION_ERROR
  TENANT_MISMATCH
  USER_DATA_ACCESS_ATTEMPT
  USER_DATA_ACCESSED
  USER_LIST_ACCESSED
  USER_LIST_ACCESS_DENIED
  USER_PROFILE_UPDATE
  USER_PROFILE_UPDATE_FAILED
  USER_LIST_ATTEMPTED
  ROLE_ACCESS_DENIED
  ROLE_ACCESS_GRANTED
  PRIVILEGE_ACCESS_DENIED
  PRIVILEGE_ACCESS_GRANTED
  SENSITIVE_DATA_ACCESSED
  AUDIT_TRAIL_ACCESS_DENIED
  AUDIT_TRAIL_ACCESS_ATTEMPTED
  AUDIT_TRAIL_ACCESSED
  DATA_EXPORT_ATTEMPTED
  DATA_EXPORT_ATTEMPT_DENIED
  DATA_EXPORT_INITIATED
  DATA_EXPORTED
  SECURITY_STATUS_CHECKED
  SECURITY_RATE_LIMIT
  AUTHENTICATION_VERIFICATION_FAILED
  AUTHENTICATION_VERIFIED
  LOGOUT_ATTEMPT_INVALID
  ADMIN_VALIDATION_ERROR
  UNAUTHORIZED_TENANT_CREATION_ATTEMPT
  TENANT_CREATION_FAILED
  INTERNAL_ERROR
}

enum EventSeverity {
  INFO
  SECURITY
  CRITICAL
  ERROR
}

enum PermissionAction {
  CREATE
  READ
  UPDATE  
  DELETE
  EXECUTE
}

enum ConditionType {
  OWN_DATA_ONLY      
  TENANT_DATA_ONLY   
  TIME_BASED         
  IP_RESTRICTED      
  MFA_REQUIRED       
  RATE_LIMITED      
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id        String          @id @default(uuid())
  name      String
  slug      String          @unique
  status    TenantStatus    @default(ACTIVE)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  users     User[]
  oauth     OAuthProvider[]
  policies  TenantPolicy?
  branding  Json?

  OTP OTP[]

  Session Session[]

  Role Role[]

  MFAFactor MFAFactor[]

  BackupCode BackupCode[]

  PermissionRule PermissionRule[]

  Permission Permission[]

  rateLimitProfile TenantRateLimitProfile[]
}

model User {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  phone           String
  email           String?
  name            String?
  passwordHash    String? // optional fallback
  isPhoneVerified Boolean  @default(false)
  isEmailVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  otpCodes         OTP[]
  oauthProviders   OAuthProvider[]
  sessions         Session[]
  roles            UserRole[]
  mfaFactors       MFAFactor[]
  backupCodes      BackupCode[]
  UsedRefreshToken UsedRefreshToken[]
  PermissionAudit PermissionAudit[]
  userPermissions  UserPermission[]

  @@unique([tenantId, phone]) // phone unique per tenant
  @@unique([tenantId, email])
}

model UserPermission {
  id           String       @id @default(uuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  permissionId String
  permission   Permission   @relation(fields: [permissionId], references: [id])
  allowed      Boolean      @default(true)
  grantedBy    String?      // "direct", "role_assignment", "inheritance"
  grantedAt    DateTime     @default(now())
  
  @@unique([userId, permissionId])
}

model OTP {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String? // nullable until user created
  user      User?    @relation(fields: [userId], references: [id])
  channel   String // "PHONE" | "EMAIL"
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  refreshHash  String
  userAgent    String?
  ipAddress    String?
  csrfToken    String?
  createdAt    DateTime @default(now())
  lastActiveAt DateTime
  expiresAt    DateTime // aligned with refresh token expiry
  revoked      Boolean  @default(false)
  revokedAt DateTime? 
  updatedAt    DateTime @default(now())
  RefreshToken     RefreshToken[]
  UsedRefreshToken UsedRefreshToken[]
}

model RefreshToken {
  id         String             @id @default(uuid())
  sessionId  String
  session    Session            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash  String             @unique
  parentId   String? // previous token in chain
  parent     RefreshToken?      @relation("parent_child", fields: [parentId], references: [id])
  children   RefreshToken[]     @relation("parent_child")
  familyId   String // id of the root token (first token in family)
  revoked    Boolean            @default(false)
  usedTokens UsedRefreshToken[]
  expiresAt  DateTime
  createdAt  DateTime           @default(now())

  @@index([familyId])
  @@index([sessionId])
}

model UsedRefreshToken {
  id             String        @id @default(cuid())
  tokenHash      String        @unique
  usedAt         DateTime      @default(now())
  sessionId      String?
  userId         String?
  session        Session?      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenId String?
  RefreshToken   RefreshToken? @relation(fields: [refreshTokenId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([usedAt])
  @@index([userId])
  @@index([tokenHash])
  @@index([refreshTokenId])
}

// IP blocking table
model IPBlock {
  id         String   @id @default(cuid())
  ip         String
  reason     String
  blockedAt  DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([ip])
  @@index([expiresAt])
}

// IP whitelist table
model IPWhitelist {
  id        String   @id @default(cuid())
  ip        String
  reason    String
  addedAt   DateTime @default(now())
  addedBy   String?  // admin user who added it

  @@unique([ip])
  @@index([addedAt])
}

// Reputation history (optional, for advanced tracking)
model IPReputationHistory {
  id         String   @id @default(cuid())
  ip         String
  score      Int
  riskLevel  String   // 'LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL'
  eventCounts Json?   // JSON object with event type counts
  recordedAt DateTime @default(now())
  source     String   // 'EVENT_LOG' | 'MANUAL_UPDATE' | 'SYSTEM_UPDATE'

  @@index([ip, recordedAt])
  @@index([recordedAt])
}

model Event {
  id       String    @id @default(uuid())
  userId   String?
  tenantId String?
  type     EventType

  sessionId String? @db.Uuid
  familyId  String?
  reason    String?

  severity  EventSeverity @default(INFO)
  metadata  Json?
  ipAddress String? // NEW: client IP for forensics
  userAgent String? // NEW: client UA for forensics

  integrityHash String   @db.VarChar(128)
  prevHash      String?  @db.VarChar(128)
  createdAt     DateTime @default(now())

  @@index([type, createdAt])
  @@index([sessionId])
  @@index([familyId])
  @@index([reason])
}

model OAuthProvider {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  provider       String // e.g., GOOGLE, GITHUB, APPLE
  providerUserId String
  accessToken    String?
  refreshToken   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, provider, providerUserId])
}

model Permission {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String   // "manage_orders", "view_sensitive_data"
  description String?
  resource    String   // "orders", "users", "products"
  action      PermissionAction
  createdAt   DateTime @default(now())
  
  // Advanced permission features
  conditions  PermissionCondition[]
  rolePermissions RolePermission[]
  
  @@unique([tenantId, name])
  PermissionAudit PermissionAudit[]
  UserPermission UserPermission[]
}

model PermissionCondition {
  id             String        @id @default(uuid())
  permissionId   String
  permission     Permission    @relation(fields: [permissionId], references: [id])
  conditionType  ConditionType
  value          Json?         // condition-specific value (IP range, time window, etc.)
  description    String?
  createdAt      DateTime      @default(now())
}

model Role {
  id          String             @id @default(uuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  isSystem    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  
 // Backward compatibility - keep existing privileges array
  privileges  String[]           @default([]) // for legacy role-based permissions

  // Hierarchical roles (role inheritance)
  parentRoleId String?
  parentRole   Role?             @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles   Role[]            @relation("RoleHierarchy")
  
  // Permissions
  permissions  RolePermission[]
  userRoles    UserRole[]
  
  // Role metadata for advanced scenarios
  priority      Int?             // for conflict resolution
  isActive      Boolean          @default(true)
  validFrom     DateTime?
  validUntil    DateTime?
  

  TenantPolicy TenantPolicy[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])
  createdAt    DateTime        @default(now())
  validFrom    DateTime 
  validUntil   DateTime       
}

model RolePermission {
  id           String          @id @default(uuid())
  roleId       String
  role         Role            @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission      @relation(fields: [permissionId], references: [id])
  allowed      Boolean         @default(true)
  inherited    Boolean         @default(false) // from parent role
  priority     Int?            // for conflict resolution
  createdAt    DateTime        @default(now())
  
  @@unique([roleId, permissionId])
}

model MFAFactor {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  type      String // SMS, TOTP, WEBAUTHN, BACKUP_CODE
  secret    String? // e.g., TOTP secret or WebAuthn credential JSON
  phone     String? // for SMS factor
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BackupCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  codeHash  String
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// For tenant-level permission policies
model TenantPolicy {
  id                        String   @id @default(uuid())
  tenantId                  String   @unique
  tenant                    Tenant   @relation(fields: [tenantId], references: [id])
  requireMFA                Boolean  @default(false)
  allowedFactors            Json?
  privilegedUserMFARequired Boolean  @default(true)
  
  // New: Default permissions for new users
  defaultRoleId             String?
  defaultRole               Role?    @relation(fields: [defaultRoleId], references: [id])
  
  // New: Permission inheritance rules
  roleInheritanceEnabled    Boolean  @default(true)
  permissionConflictStrategy String @default("DENY_WINS") // "DENY_WINS", "ALLOW_WINS", "HIGHEST_PRIORITY"

  customRateLimitProfileId  String?
  customRateLimitProfile    TenantRateLimitProfile? @relation(fields: [customRateLimitProfileId], references: [id])
  
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model TenantRateLimitProfile {
  id         String              @id @default(cuid())
  tenantId   String              
  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  name       String              // e.g., 'standard', 'premium', 'enterprise'
  limits     Json                // JSON object containing rate limit configs
  isActive   Boolean             @default(true)
  isDefault  Boolean             @default(false) // Mark as default profile
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

 
  tenantPolicies TenantPolicy[]

  @@index([tenantId])
  @@index([isActive])
  @@index([isDefault])
  @@unique([tenantId, name]) 
}

// For tracking permission usage and auditing
model PermissionAudit {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  action       String   // "ATTEMPTED", "GRANTED", "DENIED"
  resource     String   // actual resource accessed
  resourceId   String?  // specific record ID
  ipAddress    String?
  userAgent    String?
  reason       String?  // why permission was denied
  createdAt    DateTime @default(now())
  
  @@index([userId, createdAt])
  @@index([permissionId, createdAt])
  @@index([action])
}

// For dynamic permission evaluation
model PermissionRule {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  description  String?
  condition    Json     // JSON logic for when rule applies
  effect       String   // "ALLOW", "DENY", "CONDITIONAL"
  priority     Int      // execution order
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  
  @@index([tenantId, priority])
}