# latch-apps/apps/latch-auth/.env.test

# App
PORT=3000
NODE_ENV=test

# Database
DATABASE_URL="postgresql://latch:latch123@localhost:5432/latch_auth"

# Redis (use localhost if running Redis in Docker on host network, or adjust)
REDIS_URL=redis://redis:6379

# JWT Secrets
JWT_SECRET=super-secret-jwt
REFRESH_SECRET=super-refresh-secret
COOKIE_SECRET=mock-cookie-secret
AUDIT_HASH_SECRET=audit-hash-secret
# Mock AWS credentials (for mock pipelines only)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=fake
AWS_SECRET_ACCESS_KEY=fake
EVENT_SIGNING_SECRET=mock-signing-secret